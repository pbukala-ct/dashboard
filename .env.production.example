# Set these in the Netlify dashboard under Site Settings > Environment Variables

# From CT Merchant Center > Custom Applications > your app > Application ID
CUSTOM_APPLICATION_ID=

# The Netlify URL of this app (e.g. https://mc-discount-dashboard.netlify.app)
APP_URL=

# The preview calculator app URL (used in CSP headers for frame-src and connect-src)
PREVIEW_HOST=https://discount-preview-calculator-anz.netlify.app
